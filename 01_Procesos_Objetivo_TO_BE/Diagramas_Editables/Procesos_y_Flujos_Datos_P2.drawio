ell><mxCell id="task5" value="5. Conciliar bancos, contabilidad y control presupuestario y resolver diferencias con evidencia." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;El pago cancela una obligación; no constituye una segunda reducción del disponible ya comprometido y devengado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#EEE0F7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Validar circuito con Finanzas y servicio contable externo, incluidos pagos anticipados permitidos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 5–7; Q08; respuesta Conservación pregunta 9; propuesta financiera" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Pago conciliado y estado financiero actualizado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB07 Formalizar donación y entrega institucional" id="GOB07"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB07 Formalizar donación y entrega institucional" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Conservación con apoyo jurídico y autoridad competente" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Bienes recibidos, destino y respaldo de transferencia." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColo