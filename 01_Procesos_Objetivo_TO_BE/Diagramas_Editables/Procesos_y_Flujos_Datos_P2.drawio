 value="4. Registrar cambio de custodia o titularidad y referencias de inventario y contabilidad." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Conservar constancia de aceptación, condiciones de uso y seguimiento acordado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;La recepción del proveedor no prueba que el bien fue entregado o donado a la institución." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Revisión jurídica del título, competencia y documentos de donación. No inventar una norma de transferencia no localizada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;Respuesta Conservación pregunta 10; contexto confirmado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Donación documentada y trazabilidad del destino." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB08 Cerrar el proyecto de gobierno" id="GOB08"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB08 Cerrar el proyecto de gobierno" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Conservación con Finanzas Cumplimiento y Sostenibilidad" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Objetivo ejecutado y expedientes de compras y entregas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Consolidar resultados, bienes recibidos, gastos y saldos por actividad y partida." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Confirmar pagos, garantías pendientes, donaciones formalizadas y obligaciones de salvaguardas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Registrar incumplimientos, reclamos y obligaciones que deban continuar después del cierre." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Obtener pronunciamientos y el instrumento de cierre de la autoridad competente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Completar índice y conservación del expediente y habilitar reportes institucionales." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No cerrar solo porque el saldo de caja es cero o se agotó el plazo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Validar criterios de cierre y responsabilidades de seguimiento posterior." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N06 6.1.9; respuesta Conservación pregunta 10" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Cierre integral y expediente final." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="TR01 Gestionar cumplimiento y el maestro de contrapartes" id="TR01"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TR01 Gestionar cumplimiento y el maestro de contrapartes" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Cumplimiento y Operaciones" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Solicitud de vinculación y persona natural o jurídica identificada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Buscar la contraparte para evitar duplicados y registrar el proceso solicitante y el hito requerido." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Solicitar datos y anexos proporcionales mediante acceso individual con vencimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Revisar completitud, personas relacionadas y fuentes autorizadas. Registrar consulta, fecha, hallazgo y evidencia." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Resolver falsos positivos, escalar alertas y emitir informe y decisión humana de riesgo y habilitación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Comunicar a las áreas solo el estado necesario y mantener reservado el expediente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task6" value="6. Programar actualización según riesgo y eventos. Revalidar vigencia antes de decisiones críticas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="845" width="550" height="90" as="geometry" /></mxCell><mxCell id="e6" value="" edge="1" source="task5" target="task6" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Ninguna coincidencia potencial es una condena ni autoriza rechazo automático. Una prohibición normativa no se convierte en aprobación condicionada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar fuentes de screening, autoridad de casos escalados y tratamiento de datos. Renovaciones de 12/24/36 meses según nivel de riesgo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N08 3–10; Q10; diseño KYC/CSC existente" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Contraparte con estado, informe y próxima revisión." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="970" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task6" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="1080" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="TR02 Registrar tramitar y archivar correspondencia externa" id="TR02"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TR02 Registrar tramitar y archivar correspondencia externa" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Cumplimiento y Operaciones" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Comunicación recibida o documento autorizado para envío." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Registrar recepción o generación con código, emisor, destinatario, fecha, asunto y expediente relacionado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Digitalizar y vincular el original físico, asignar responsable y plazo cuando corresponda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Preparar respuesta, obtener revisión y firma y registrar envío por canal autorizado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Conservar acuse, constancia de entrega y relaciones entre comunicación inicial y respuesta." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Cerrar el trámite y aplicar clasificación, permisos y conservación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No confundir documento preparado con documento firmado, enviado o recibido." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#EEE0F7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Confirmar canales oficiales y numeración institucional única o por serie, sin colisiones." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;P1; respuesta Gestión Documental; diseño propuesto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Registro y expediente de comunicación completo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="TR03 Custodiar expedientes y decisiones internas" id="TR03"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TR03 Custodiar expedientes y decisiones internas" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Cumplimiento y Operaciones con dueños de información" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Documentos de proyectos, contratos, decisiones y correos relevantes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Aplicar clasificación, metadatos y vínculo al expediente sin duplicar el original autoritativo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Identificar versión de trabajo, revisada, aprobada y firmada, con control de reemplazos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Capturar las aprobaciones y disposiciones por correo que generan responsabilidad o cambian obligaciones." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Conceder acceso por rol y necesidad, registrar acciones relevantes y conservar originales físicos cuando proceda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Aplicar plazos de conservación y eliminación autorizada con suspensión por auditoría o litigio cuando corresponda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No se entrega el expediente completo reservado a todo el personal. El correo cotidiano no requiere burocracia adicional." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar política de conservación por serie, permisos y tratamiento de firmas y actas pendientes de aprobación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 6; Q07; N08 9–10; P1" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Expediente íntegro y decisiones recuperables." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="TR04 Gestionar archivo audiovisual y su consulta" id="TR04"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TR04 Gestionar archivo audiovisual y su consulta" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Comunicación con soporte de tecnología" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Material de fotografía, audio, video y autorizaciones de uso." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Recibir archivos y registrar proyecto, actividad, fecha, isla, autoría, personas identificables y derechos de uso." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Conservar el original en el repositorio designado y crear versiones ligeras para búsqueda y consulta." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Clasificar, etiquetar y vincular con expedientes y productos de comunicación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Aplicar permisos y respaldo local y externo según criticidad y retención aprobadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Verificar restauración y autorizar publicación sin exponer material restringido." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Sincronización no equivale a respaldo. No enviar todo el material a nube sin medir volumen, conexión y costo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Medir volumen y crecimiento y validar retención, derechos y alcance del respaldo externo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;P1; contexto confirmado; diseño propuesto A09/A10" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Biblioteca audiovisual con metadatos y copias verificadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="DFD0 Contexto del sistema maestro" id="DFD0"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="central" value="Sistema maestro propuesto del GLF&#10;Identificadores compartidos, procesos diferenciados, permisos y trazabilidad" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;fontStyle=1;"><mxGeometry x="390" y="390" width="320" height="145" as="geometry" /></mxCell><mxCell id="post" value="Postulante y beneficiario" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;rounded=0;"><mxGeometry x="40" y="110" width="270" height="75" as="geometry" /></mxCell><mxCell id="inpost" value="Datos, propuestas, informes y evidencias" edge="1" source="post" target="central" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="outpost" value="Observaciones, decisiones y notificaciones" edge="1" source="central" target="post" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gov" value="Institución pública" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;rounded=0;"><mxGeometry x="790" y="110" width="270" height="75" as="geometry" /></mxCell><mxCell id="ingov" value="Necesidad, términos y constancia de recepción" edge="1" source="gov" target="central" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="outgov" value="Entrega y documentación de donación" edge="1" source="central" target="gov" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="supplier" value="Proveedor y contraparte" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;rounded=0;"><mxGeometry x="40" y="700" width="270" height="75" as="geometry" /></mxCell><mxCell id="insupplier" value="Ofertas y documentación de cumplimiento" edge="1" source="supplier" target="central" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="outsupplier" value="Requerimientos, observaciones y resultado" edge="1" source="central" target="supplier" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="areas" value="Áreas del GLF" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;rounded=0;"><mxGeometry x="790" y="700" width="270" height="75" as="geometry" /></mxCell><mxCell id="inareas" value="Revisiones, planificación y decisiones autorizadas" edge="1" source="areas" target="central" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="outareas" value="Bandejas, alertas, expedientes y reportes" edge="1" source="central" target="areas" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="reserved" value="Expediente reservado de cumplimiento&#10;Acceso solo por necesidad de saber" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=datastore;"><mxGeometry x="390" y="90" width="320" height="95" as="geometry" /></mxCell><mxCell id="restricted" value="Solicitudes y consultas autorizadas" edge="1" source="central" target="reserved" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="store" value="Registros institucionales&#10;Proyectos, actividades, partidas, obligaciones, documentos y auditoría" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=datastore;"><mxGeometry x="390" y="800" width="320" height="110" as="geometry" /></mxCell><mxCell id="save" value="Registro y consulta por permisos" edge="1" source="central" target="store" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="Diagrama de contexto conceptual. Las áreas consumen el estado habilitante de cumplimiento sin recibir indiscriminadamente el expediente reservado. Las compras de gobierno y los gastos reportados por beneficiarios conservan su modalidad." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="40" y="980" width="980" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>