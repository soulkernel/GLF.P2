<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-22T00:00:00.000Z" agent="GLF" version="24.0.0" type="device"><diagram name="SUB01 Preparar autorizar y publicar la convocatoria" id="SUB01"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB01 Preparar autorizar y publicar la convocatoria" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Proyectos con Dirección Ejecutiva y Comunicación" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Prioridades institucionales, calendario de Junta y disponibilidad de recursos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Consolidar prioridades y propuesta de convocatoria con aportes de las áreas y recomendación técnica que corresponda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Elevar los temas, categorías, recursos, bases y calendario a la instancia competente y registrar su decisión." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Configurar requisitos, formularios, criterios, fechas, zona horaria y canales con una versión identificable." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Probar el formulario y su archivo con casos de prueba. Obtener autorización de publicación y conservar evidencia." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Publicar bases y preguntas frecuentes en canales oficiales. Comunicar cambios a todos los interesados afectados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No abrir una convocatoria sin bases y calendario autorizados. Distinguir ajustes operativos de cambios sustantivos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar el instrumento habilitante mientras el acta de Junta queda pendiente de aprobación. No atribuir a un borrador de acta eficacia que no haya sido reconocida." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 3–6; respuesta Proyectos preguntas 1 y 2" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Convocatoria publicada y configuración versionada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB02 Registrar la nota conceptual y crear el expediente" id="SUB02"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB02 Registrar la nota conceptual y crear el expediente" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Postulante y Proyectos" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Convocatoria vigente y formulario aprobado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Autenticar al postulante con un mecanismo apropiado y registrar su identidad sin abrir todavía el expediente completo reservado de cumplimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Permitir guardar avances y adjuntar los documentos exigidos por la convocatoria, con controles de formato y tamaño." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Al enviar, validar campos obligatorios, fecha límite y duplicados. Guardar la versión presentada y una marca de tiempo trazable." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Asignar código único y emitir acuse que confirme recepción, sin declarar elegibilidad ni aprobación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Crear el índice de expediente, asignar responsables y poner la solicitud en la bandeja de revisión." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Recepción no equivale a admisión ni financiación. Conservar la versión recibida aunque luego se subsane." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Confirmar fecha y hora oficial, límites de archivos, datos del acuse y regla de duplicados por convocatoria." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 5–6; P1; diseño de automatización" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Nota conceptual registrada y acuse de recibo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB03 Verificar admisibilidad y gestionar subsanaciones" id="SUB03"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB03 Verificar admisibilidad y gestionar subsanaciones" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Proyectos y Sostenibilidad" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Nota conceptual registrada y lista de requisitos vigente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Revisar tema, elegibilidad, integridad, oportunidad, categoría presupuestaria y evaluación ambiental y social inicial." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Registrar cada requisito con resultado, observación, responsable y evidencia, sin confundir falta documental con valoración técnica." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Consolidar observaciones y notificar al postulante por el canal formal conservando el contenido de la comunicación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Recibir la nueva versión dentro del plazo autorizado, mantener la anterior y verificar el levantamiento de cada observación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Cerrar el control administrativo con resultado motivado y habilitar la etapa siguiente únicamente cuando corresponda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;La subsanación después del cierre no se concede por defecto. Debe tener causa, autoridad y respaldo compatibles con las bases." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar faltantes subsanables, plazos, rondas y tratamiento excepcional después del cierre." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 6 pp.8–9; respuesta Proyectos preguntas 3 y 4" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Ficha administrativa y resultado de admisibilidad." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB04 Evaluar y preseleccionar notas conceptuales" id="SUB04"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB04 Evaluar y preseleccionar notas conceptuales" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Comité Asesor Técnico con soporte de Proyectos" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Expediente admisible, criterios y lista de evaluadores habilitados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Registrar confidencialidad y conflictos antes de conceder acceso. Aplicar el alcance de la abstención previsto por la norma." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Distribuir el expediente y la ficha administrativa al menos diez días laborables antes de la reunión." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Recibir puntuaciones individuales tres días laborables antes. Registrar autoría, versión de rúbrica y cierre de edición." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Consolidar el promedio y aplicar la regla de puntuación de la convocatoria basada en el Manual vigente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Documentar deliberación, clasificación y preselección. Registrar la intervención de Junta que corresponda a la convocatoria y comunicar el resultado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Los observadores sin voto no se contabilizan como evaluadores decisores. La reunión no elimina la evaluación individual previa." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#EEE0F7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar el alcance de la aprobación de Junta antes de la segunda fase y el tratamiento de quórum, empates y reemplazos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 2,6; Q01,Q02,Q03; respuesta Proyectos pregunta 5" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Matriz de evaluación, acta e invitaciones o notificaciones." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB05 Recibir y acompañar la propuesta completa" id="SUB05"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB05 Recibir y acompañar la propuesta completa" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Postulante con Proyectos Sostenibilidad y apoyo financiero cuando corresponda" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Invitación y observaciones derivadas de la preselección." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Comunicar requisitos, fecha límite, observaciones y condiciones para presentar la propuesta completa." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Iniciar el proceso de cumplimiento aplicable en paralelo, usando TR01 sin duplicar la ficha de contraparte." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Recibir objetivos, resultados, actividades, cronograma, presupuesto, indicadores y documentos de salvaguardas exigidos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Acompañar mediante observaciones y orientación trazables, manteniendo la autoría y responsabilidad del proponente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Registrar versiones, verificar integridad y derivar la propuesta completa a las revisiones especializadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;El acompañamiento no autoriza al personal del GLF a asumir la elaboración ni la responsabilidad del proyecto." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Confirmar participación exacta y límites del apoyo financiero en esta fase y los plazos por categoría." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 5–6; N06 6.1; respuesta Proyectos pregunta 6" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Propuesta completa registrada y revisiones asignadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB06 Revisar calificar y recomendar la propuesta completa" id="SUB06"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB06 Revisar calificar y recomendar la propuesta completa" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Áreas técnicas y Comité Asesor Técnico" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Propuesta completa, fichas, análisis de salvaguardas y cumplimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Revisar el cumplimiento administrativo y el análisis ambiental y social completo con los instrumentos aplicables." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Solicitar y verificar ajustes. Conservar la propuesta que será evaluada y las observaciones levantadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Distribuir expedientes depurados al Comité respetando confidencialidad, abstenciones y calendario de evaluación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Recibir evaluaciones individuales, consolidar resultados y documentar el análisis y la recomendación motivada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Antes de elevar para decisión final, comprobar informes requeridos y resultado vigente de cumplimiento, sin alertas sin resolver." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Una recomendación favorable no equivale a adjudicación ni permite firmar contrato." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Determinar con las áreas la lista de dictámenes bloqueantes y cómo tratar condiciones pendientes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 6–7; N06 6.1.5; Q01,Q02,Q04; contexto confirmado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Expediente y recomendación motivada para Junta." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB07 Resolver la adjudicación y notificar" id="SUB07"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB07 Resolver la adjudicación y notificar" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Junta Directiva y Dirección Ejecutiva" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Expediente completo y recomendación del Comité." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Integrar el punto de agenda, antecedentes y propuesta de decisión sin pedir a Junta que opere el sistema de postulaciones." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Presentar la información consolidada y registrar las decisiones adoptadas por el órgano competente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Vincular resolución o acta, condiciones, monto y propuesta aprobada. Distinguir decisión adoptada de documento pendiente de formalización." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Notificar a cada postulante el resultado y las condiciones aplicables, conservando constancia de entrega." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Habilitar preparación contractual solo con evidencia suficiente de la decisión y de cumplimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;El personal registra la decisión; no vota en nombre de la Junta. Un tablero consultivo futuro será de solo lectura." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar documentos que permiten ejecutar una decisión antes de la aprobación posterior del acta." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 7; Q04; respuesta Proyectos pregunta 5" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Decisión trazable y notificación formal." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB08 Formalizar contrato y línea base del proyecto" id="SUB08"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB08 Formalizar contrato y línea base del proyecto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Cumplimiento y Operaciones con Dirección Ejecutiva" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Decisión de adjudicación, propuesta aprobada y habilitación vigente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Integrar el contrato de subvención con documentos de identificación, condiciones, presupuesto, cronograma y anexos aplicables." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Verificar la concordancia entre decisión, propuesta y contrato, incluidas obligaciones de salvaguardas y rendición de cuentas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Obtener revisiones y firmas autorizadas. Registrar versión firmada y vínculo al original físico cuando exista." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Crear la línea base contractual y sus hitos sin volver a digitar datos ya aprobados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Activar calendario, responsables, indicadores y condiciones del primer desembolso." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No confundir convenio modelo del Manual con la denominación efectiva del instrumento suscrito. No alterar el original firmado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#EEE0F7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Confirmar plantilla institucional vigente y reglas de firma, representación y custodia." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N01 7 y Anexo 5; N06 6.1.6; respuesta Proyectos pregunta 9" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Contrato firmado y línea base versionada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB09 Tramitar el primer desembolso" id="SUB09"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB09 Tramitar el primer desembolso" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Finanzas con autorizadores institucionales" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Contrato vigente y condiciones previas cumplidas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Verificar condiciones específicas del contrato, identidad de contraparte, cuenta validada y habilitación vigente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Consolidar la solicitud y los respaldos exigibles para el primer desembolso, sin exigir informes periódicos que aún no correspondan." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Aplicar el circuito de revisión y autorización bancaria con separación de funciones." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Registrar transferencia, comprobante y conciliación y vincularlos al proyecto y a la obligación contractual." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Comunicar resultado y activar plazos contados desde desembolso cuando el contrato así lo determine." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;La lista de condiciones debe diferenciar primer desembolso de desembolsos posteriores." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Finanzas debe validar el circuito bancario y contable y los documentos requeridos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;Contrato de subvención aplicable; P1; diseño propuesto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Desembolso registrado y conciliado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB10 Ejecutar y reportar avances y gastos" id="SUB10"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB10 Ejecutar y reportar avances y gastos" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Beneficiario con revisión del GLF" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Línea base contractual y recursos desembolsados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. El beneficiario ejecuta el proyecto y realiza sus compras conforme a las condiciones aplicables." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Registrar actividades, hitos, gastos declarados, indicadores y medios de verificación por periodo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Presentar informes técnicos, financieros y de salvaguardas según contrato y requisitos institucionales." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Relacionar cada evidencia con el resultado, periodo y actividad que pretende demostrar." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Mostrar avance declarado y avance validado en campos separados y notificar pendientes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;El GLF supervisa, pero no registra como compras propias todas las adquisiciones realizadas por el beneficiario." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Validar formatos, calendario y criterios de gastos admisibles por contrato." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;P1; N06 6.1.7; contrato de subvención" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Informes y evidencias de ejecución." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB11 Revisar informes y controlar acciones correctivas" id="SUB11"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB11 Revisar informes y controlar acciones correctivas" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Proyectos Sostenibilidad y Finanzas" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Informe presentado y evidencias vinculadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Asignar revisiones independientes por especialidad sin mezclar el juicio técnico con la revisión financiera." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Registrar hallazgos y solicitar correcciones consolidadas con responsable, fecha y evidencia esperada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Programar visitas o verificaciones por riesgo y documentar sus resultados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Revisar la respuesta y emitir pronunciamiento de cada área conservando historial." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Escalar incumplimientos persistentes y cambios de riesgo al nivel competente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;La presencia de un archivo no acredita cumplimiento. La periodicidad de salvaguardas no se fija universalmente en trimestral sin contrato." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Resolver discrepancia entre frecuencia trimestral y frecuencia según contrato. El Manual prevé al menos dos informes anuales y frecuencia definida por GLF." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N06 6.1.7; P1; respuestas Sostenibilidad" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Dictámenes, acciones correctivas y revisión cerrada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB12 Tramitar desembolsos posteriores" id="SUB12"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB12 Tramitar desembolsos posteriores" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Finanzas con Dirección Ejecutiva y autorizadores" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Hito de pago y revisiones requeridas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Identificar el hito contractual y comprobar condiciones, saldos y documentación exigida." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Consolidar los pronunciamientos técnico, financiero y de salvaguardas cuando sean exigibles." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Mantener pendiente el pago si falta una condición o existe un dictamen no favorable sin resolución válida." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Aplicar autorizaciones segregadas y registrar pago y conciliación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Actualizar saldo por desembolsar sin confundirlo con gasto ejecutado por el beneficiario." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Desembolsado no equivale a devengado ni a avance físico." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#EEE0F7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Validar excepciones y autorizadores por tipo de desembolso." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;Contrato de subvención; P1; N06 6.1.7" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Pago y expediente de autorización." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB13 Gestionar cambios e incumplimientos" id="SUB13"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB13 Gestionar cambios e incumplimientos" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Área técnica con Finanzas Sostenibilidad y Dirección Ejecutiva" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Solicitud de cambio, incidente o incumplimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Registrar la situación y su impacto en objetivos, actividades, presupuesto, plazos y riesgos." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Obtener análisis y recomendaciones de las áreas afectadas antes de modificar la línea base." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Determinar la autoridad y el instrumento exigibles conforme al contrato, las políticas y delegaciones vigentes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Registrar decisión y versión nueva, manteniendo la anterior y notificando a las partes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Escalar suspensión, terminación o recuperación de recursos cuando corresponda y documentar obligaciones subsistentes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;El vencimiento bloquea nuevas actuaciones no autorizadas, pero no borra obligaciones legítimas de pago, rendición o cierre." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar límites, delegaciones y tratamiento de liquidaciones posteriores al vencimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;Contrato aplicable; N06 6.1.7; diseño propuesto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Cambio formalizado o decisión de incumplimiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="SUB14 Cerrar y consolidar resultados" id="SUB14"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SUB14 Cerrar y consolidar resultados" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Áreas técnica financiera de salvaguardas y jurídica documental" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Finalización de actividades y obligaciones." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Solicitar informes finales y verificables previstos en contrato." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Evaluar resultados técnicos, financieros y de salvaguardas y registrar asuntos aún pendientes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Completar saldos, reintegros, bienes y obligaciones posteriores según corresponda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Formalizar cierres por especialidad y la aceptación final de autoridad competente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Cerrar el expediente, aplicar conservación y publicar solo resultados autorizados y sin datos reservados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;El cierre técnico no sustituye el financiero, de salvaguardas o jurídico documental." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Validar lista final, responsables, instrumento de cierre y conservación por serie." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N06 6.1.8; Q09; contrato aplicable" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Acta o instrumento de cierre y expediente completo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB01 Aprobar el proyecto de gobierno y su presupuesto" id="GOB01"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB01 Aprobar el proyecto de gobierno y su presupuesto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Conservación con Finanzas y Dirección Ejecutiva" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Necesidad de institución pública y decisión institucional." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Identificar institución, objetivo, alcance y documento que sustenta la intervención del GLF." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Preparar actividades, cronograma, bienes y servicios, resultados, riesgos y presupuesto detallado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Finanzas asigna proyecto, actividad, partida y fuente para cada necesidad y verifica disponibilidad." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Obtener aprobación e instrumento de ejecución de las autoridades competentes." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Cargar una sola línea base autorizada que servirá para ejecutar y controlar sin recapturas ni aprobaciones presupuestarias repetitivas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No ejecutar compras sin presupuesto previo. La autoridad y el instrumento no se infieren de una pantalla." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Ratificar distinción entre presupuesto anual, aprobación del proyecto e instrumento que autoriza su ejecución." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 1.4; Q05; N06 6.1.9; respuesta Conservación" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Proyecto habilitado y línea base presupuestaria." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB02 Iniciar la adquisición y reservar presupuesto" id="GOB02"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB02 Iniciar la adquisición y reservar presupuesto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Responsable técnico de Conservación" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Actividad y necesidad previstas en línea base." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Generar el requerimiento desde el proyecto, actividad y partida aprobados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Completar términos de referencia o especificaciones y estimación sin perder el vínculo presupuestario." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Verificar saldo y reservar el importe estimado para evitar comprometerlo simultáneamente en otra compra." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Determinar procedimiento y requisitos según monto, naturaleza y política vigente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Si la compra no está prevista, cambia de partida o aumenta el monto, tramitar la excepción antes de continuar." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;La reserva y la determinación de procedimiento no sustituyen las aprobaciones de contratación exigidas por política." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#EEE0F7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Validar base de cálculo del monto, límites exactos y tratamiento de operaciones relacionadas sin fraccionamiento." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 1.4 y 2; Q05,Q11,Q12; propuesta de control financiero" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Requerimiento trazable y reserva." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB03 Solicitar comparar y seleccionar ofertas" id="GOB03"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB03 Solicitar comparar y seleccionar ofertas" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Responsable de adquisiciones y evaluadores competentes" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Requerimiento, procedimiento y presupuesto disponible." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Identificar proveedores registrados y solicitar ofertas comparables conforme al nivel de contratación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Conservar comunicaciones, ofertas, fechas, independencia de proveedores y criterios de evaluación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Gestionar cumplimiento en paralelo por TR01 para las contrapartes con posibilidad real de selección." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Evaluar calidad, precio, entrega, garantía, sostenibilidad y capacidad técnica según las reglas publicadas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Obtener selección autorizada y documentada, con cumplimiento habilitante antes de formalizar la adjudicación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Registro comercial no equivale a habilitación. No omitir cotizaciones por rapidez ni asumir ofertas independientes entre canales vinculados." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D6F0E7;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Aclarar respuesta que atribuye selección preliminar al Oficial de Cumplimiento. Esa función no equivale a selección comercial." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 2–4; Q11,Q12; N08 4" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Comparativo, recomendación y decisión." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB04 Contratar y registrar el compromiso" id="GOB04"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB04 Contratar y registrar el compromiso" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Autoridad competente y administrador del contrato" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Selección autorizada y contraparte habilitada." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Preparar orden o contrato según procedimiento e incorporar especificaciones, entrega, precio, garantía y pago." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Obtener revisiones y firmas que correspondan y designar administrador." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Convertir la reserva en compromiso por el monto formalizado, liberando excedentes cuando proceda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Registrar cronograma, garantías, hitos y obligaciones documentales." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Gestionar cambios con respaldo y sin modificar silenciosamente la línea base." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;No registrar reserva y compromiso como dos obligaciones acumuladas de la misma compra." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#D8E8FB;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Finanzas debe validar la transición y su relación con el registro contable." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 3.4; N08 4; diseño presupuestario propuesto" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Contrato vigente y compromiso identificado." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No se declara conformidad BPMN 2.0." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;strokeColor=none;"><mxGeometry x="50" y="955" width="960" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="GOB05 Recibir verificar y reconocer la obligación" id="GOB05"><mxGraphModel dx="1100" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GOB05 Recibir verificar y reconocer la obligación" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#1F4E78;fontColor=#FFFFFF;rounded=0;fontStyle=1;"><mxGeometry x="40" y="20" width="980" height="55" as="geometry" /></mxCell><mxCell id="owner" value="Responsable&#10;Administrador del contrato y receptor designado" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="100" width="360" height="95" as="geometry" /></mxCell><mxCell id="input" value="Entrada&#10;Bien o servicio entregado y contrato vigente." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="100" width="550" height="85" as="geometry" /></mxCell><mxCell id="task1" value="1. Comprobar cantidad, especificaciones, estado, ubicación y documentación de entrega." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="220" width="550" height="90" as="geometry" /></mxCell><mxCell id="e1" value="" edge="1" source="input" target="task1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task2" value="2. Registrar conformidad o no conformidad y acciones de corrección con fechas." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="345" width="550" height="90" as="geometry" /></mxCell><mxCell id="e2" value="" edge="1" source="task1" target="task2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task3" value="3. Vincular factura y recepción conforme antes de reconocer la obligación cuando corresponda." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="470" width="550" height="90" as="geometry" /></mxCell><mxCell id="e3" value="" edge="1" source="task2" target="task3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task4" value="4. Finanzas registra el devengado contra el compromiso y la partida sin descontar dos veces la misma obligación." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="595" width="550" height="90" as="geometry" /></mxCell><mxCell id="e4" value="" edge="1" source="task3" target="task4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="task5" value="5. Registrar inventario, custodia o destino de donación y garantías aplicables." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="50" y="720" width="550" height="90" as="geometry" /></mxCell><mxCell id="e5" value="" edge="1" source="task4" target="task5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="control" value="Control y decisiones&#10;Recibido, devengado, pagado y donado son estados diferentes. No anticipar conformidad para acelerar pago." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;fillColor=#FFEAC2;"><mxGeometry x="650" y="220" width="360" height="180" as="geometry" /></mxCell><mxCell id="pending" value="Validación pendiente&#10;Definir quién certifica recepción, regla contable del devengado y documentos exigibles." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="430" width="360" height="210" as="geometry" /></mxCell><mxCell id="source" value="Fuente&#10;N03 6; Q07; respuesta Conservación preguntas 6,8,9" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;"><mxGeometry x="650" y="680" width="360" height="110" as="geometry" /></mxCell><mxCell id="output" value="Salida&#10;Acta de recepción, obligación y registro del bien." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;fillColor=#FFFFFF;strokeColor=#777777;spacing=8;shape=terminator;"><mxGeometry x="50" y="845" width="550" height="85" as="geometry" /></mxCell><mxCell id="efinal" value="" edge="1" source="task5" target="output" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;html=0;fontFamily=Arial;fontSize=11;fontColor=#000000;strokeColor=#555555;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" value="Borrador de flujo funcional. La secuencia no sustituye las compuertas, bifurcaciones y excepciones descritas en la ficha. No 